#!/bin/sh
set +e

RUNTIME_FILTERS="/var/jb/Library/Application Support/AdShield/Filters/Runtime"
mkdir -p "$RUNTIME_FILTERS"
chown mobile:mobile "$RUNTIME_FILTERS" >/dev/null 2>&1 || true
chmod 0755 "$RUNTIME_FILTERS" >/dev/null 2>&1 || true

if command -v uicache >/dev/null 2>&1; then
    uicache -a >/dev/null 2>&1
elif [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache -a >/dev/null 2>&1
fi

emit_finish_restart() {
    if [ -n "${CYDIA:-}" ]; then
        set -- $CYDIA
        finish_fd="$1"
        if [ -n "$finish_fd" ] && [ -e "/dev/fd/$finish_fd" ]; then
            printf '%s\n' 'finish:restart' > "/dev/fd/$finish_fd" 2>/dev/null
            return
        fi
    fi
    printf '%s\n' 'finish:restart'
}

emit_finish_restart
exit 0
