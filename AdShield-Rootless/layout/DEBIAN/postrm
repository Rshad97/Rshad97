#!/bin/sh
set +e

if command -v uicache >/dev/null 2>&1; then
    uicache -a >/dev/null 2>&1
elif [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache -a >/dev/null 2>&1
fi

if [ -n "${CYDIA:-}" ]; then
    set -- $CYDIA
    finish_fd="$1"
    if [ -n "$finish_fd" ] && [ -e "/dev/fd/$finish_fd" ]; then
        printf '%s\n' 'finish:restart' > "/dev/fd/$finish_fd" 2>/dev/null
        exit 0
    fi
fi

printf '%s\n' 'finish:restart'
exit 0
